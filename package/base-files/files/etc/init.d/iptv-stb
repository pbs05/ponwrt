#!/bin/sh /etc/rc.common
# 触发点2：开机立即应用一次 + 拉起常驻守护
START=95
USE_PROCD=1

start_service() {
	# 立刻补一次（端口可能还没入桥，helper 内部最多等 5s）
	/usr/libexec/iptv-stb-fix

	procd_open_instance
	procd_set_param command /usr/libexec/iptv-stb-watchdog
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() { :; }
