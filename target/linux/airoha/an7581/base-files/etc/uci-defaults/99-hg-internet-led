#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

. /lib/functions.sh

[ "$(board_name)" = "nokia,xg-040g-md-ubi" ] || exit 0

led_sysfs="green:wan-online"
[ -d "/sys/class/leds/$led_sysfs" ] || exit 1

led_configured=0
check_internet_led() {
	local sysfs
	config_get sysfs "$1" sysfs
	[ "$sysfs" = "$led_sysfs" ] && led_configured=1
}

# Supply a default to fresh and restored configurations without overwriting
# an existing LED choice, including an explicit "none".
config_load system
config_foreach check_internet_led led
[ "$led_configured" = 0 ] || exit 0

section="$(uci add system led)" || exit 1
uci set "system.$section.name=Internet" &&
uci set "system.$section.sysfs=$led_sysfs" &&
uci set "system.$section.trigger=default-route" &&
uci commit system
