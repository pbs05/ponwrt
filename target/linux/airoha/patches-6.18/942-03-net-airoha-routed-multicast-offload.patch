index 0000000..f32dd3c
--- /dev/null
+++ b/include/net/airoha_mcast.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _NET_AIROHA_MCAST_H
+#define _NET_AIROHA_MCAST_H
+
+#include <linux/if_vlan.h>
+#include <linux/skbuff.h>
+#include <linux/unaligned.h>
+
+/* AN7581 SDK frame_engine.h. Only DUPLICATE has already been forwarded. */
+enum airoha_mcast_reason {
+	AIROHA_MC_KEEPALIVE = 0x14,
+	AIROHA_MC_DUPLICATE = 0x18,
+	AIROHA_MC_ORIGINAL = 0x19,
+};
+
+/* Called after eth_type_trans, for an OWNED multicast duplicate only.
+ * SDK STAG VPM=0 adds four bytes, VPM=1 overlays the VLAN TPID. AN7581
+ * can also strip STAG into descriptor metadata. Never guess from IP bytes.
+ * QinQ is outside this backend's admitted scope.
+ */
+static inline int airoha_mcast_cpu_untag(struct sk_buff *skb, u16 stag)
+{
+	u16 raw, vpm;
+
+	if (skb->protocol == htons(ETH_P_IP) ||
+	    skb->protocol == htons(ETH_P_8021Q))
+		return 0;
+	if (!skb_mac_header_was_set(skb) ||
+	    skb->data - skb_mac_header(skb) != ETH_HLEN ||
+	    !pskb_may_pull(skb, VLAN_HLEN))
+		return -EINVAL;
+	raw = ntohs(eth_hdr(skb)->h_proto);
+	if ((raw & ~0x0300) != (stag & ~0x0300))
+		return -EINVAL;
+	vpm = (raw >> 8) & 3;
+	if (!vpm) {
+		if (get_unaligned_be16(skb->data + 2) != ETH_P_IP)
+			return -EPROTONOSUPPORT;
+		skb_pull(skb, VLAN_HLEN);
+		skb->protocol = htons(ETH_P_IP);
+	} else if (vpm == 1) {
+		skb->protocol = htons(ETH_P_8021Q);
+	} else {
+		return -EPROTONOSUPPORT;
+	}
+	return 0;
+}
+
+#endif
