diff --git a/drivers/soc/airoha/Kconfig b/drivers/soc/airoha/Kconfig
new file mode 100644
index 0000000..dbca148
--- /dev/null
+++ b/drivers/soc/airoha/Kconfig
@@ -0,0 +1,5 @@
