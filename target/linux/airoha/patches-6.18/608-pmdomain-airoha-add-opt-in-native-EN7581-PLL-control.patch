+config AIROHA_SCU
+	tristate
+	help
+	  Shared transaction lock for Airoha SCU register sequences.
diff --git a/drivers/soc/airoha/Makefile b/drivers/soc/airoha/Makefile
new file mode 100644
index 0000000..5cce672
--- /dev/null
+++ b/drivers/soc/airoha/Makefile
@@ -0,0 +1,2 @@
