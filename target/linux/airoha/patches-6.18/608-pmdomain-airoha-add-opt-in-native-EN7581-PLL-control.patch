diff --git a/drivers/soc/airoha/airoha-scu.c b/drivers/soc/airoha/airoha-scu.c
new file mode 100644
index 0000000..283c6f3
--- /dev/null
+++ b/drivers/soc/airoha/airoha-scu.c
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/soc/airoha/scu.h>
+
+/* Protect whole sequences that temporarily unlock the shared SCU registers. */
+static DEFINE_MUTEX(airoha_scu_mutex);
+
+void airoha_scu_lock(void)
+{
+	mutex_lock(&airoha_scu_mutex);
+}
+EXPORT_SYMBOL_GPL(airoha_scu_lock);
+
+void airoha_scu_unlock(void)
+{
+	mutex_unlock(&airoha_scu_mutex);
+}
+EXPORT_SYMBOL_GPL(airoha_scu_unlock);
+
+MODULE_DESCRIPTION("Airoha SCU transaction locking");
+MODULE_LICENSE("GPL");
diff --git a/drivers/thermal/Kconfig b/drivers/thermal/Kconfig
index a09c188..ff816b1 100644
--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -332,6 +332,7 @@ config AIROHA_THERMAL
 	depends on ARCH_AIROHA || COMPILE_TEST
 	depends on MFD_SYSCON
 	depends on OF
+	select AIROHA_SCU
 	help
 	  Enable this to plug the Airoha thermal sensor driver into the Linux
 	  thermal framework.
diff --git a/drivers/thermal/airoha_thermal.c b/drivers/thermal/airoha_thermal.c
index a3cc6aa..4d0919e 100644
--- a/drivers/thermal/airoha_thermal.c
+++ b/drivers/thermal/airoha_thermal.c
@@ -10,6 +10,7 @@
 #include <linux/of_address.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
+#include <linux/soc/airoha/scu.h>
 #include <linux/thermal.h>
 
 /* SCU regs */
@@ -314,6 +315,9 @@ static void airoha_set_thermal_mux(struct airoha_thermal_priv *priv,
 	unsigned int tries, sel = 0;
 	u32 pllrg;
 
+	/* CPU PLL programming uses the same write-protection register. */
+	airoha_scu_lock();
+
 	/* Save PLLRG current value */
 	regmap_read(priv->chip_scu, EN7581_PLLRG_PROTECT, &pllrg);
 
@@ -344,6 +348,7 @@ static void airoha_set_thermal_mux(struct airoha_thermal_priv *priv,
 
 	/* Restore PLLRG value on exit */
 	regmap_write(priv->chip_scu, EN7581_PLLRG_PROTECT, pllrg);
+	airoha_scu_unlock();
 }
 
 /*
diff --git a/include/linux/soc/airoha/scu.h b/include/linux/soc/airoha/scu.h
new file mode 100644
index 0000000..75fb70b
--- /dev/null
+++ b/include/linux/soc/airoha/scu.h
@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __LINUX_SOC_AIROHA_SCU_H
+#define __LINUX_SOC_AIROHA_SCU_H
+
+/* Sleepable lock; release after restoring the SCU write-protection value. */
+void airoha_scu_lock(void);
+void airoha_scu_unlock(void);
+
+#endif
