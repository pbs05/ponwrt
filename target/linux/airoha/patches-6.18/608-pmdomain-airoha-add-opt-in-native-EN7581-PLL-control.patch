From c1bef446ddd7bf144852af133ed19ba8a975e367 Mon Sep 17 00:00:00 2001
From: Huajin Wang <7976028+excelwang@users.noreply.github.com>
Date: Sun, 25 Oct 2026 22:48:48 +0800
Subject: [PATCH] pmdomain: airoha: add opt-in native EN7581 PLL control

---
 .../cpufreq/airoha,en7581-cpufreq.yaml        |  28 +++
 drivers/pmdomain/mediatek/Kconfig             |   1 +
 .../pmdomain/mediatek/airoha-cpu-pmdomain.c   | 215 +++++++++++++++++-
 drivers/soc/Kconfig                           |   1 +
 drivers/soc/Makefile                          |   1 +
 drivers/soc/airoha/Kconfig                    |   5 +
 drivers/soc/airoha/Makefile                   |   2 +
 drivers/soc/airoha/airoha-scu.c               |  22 ++
 drivers/thermal/Kconfig                       |   1 +
 drivers/thermal/airoha_thermal.c              |   5 +
 include/linux/soc/airoha/scu.h                |   9 +
 11 files changed, 289 insertions(+), 1 deletion(-)
 create mode 100644 drivers/soc/airoha/Kconfig
 create mode 100644 drivers/soc/airoha/Makefile
 create mode 100644 drivers/soc/airoha/airoha-scu.c
 create mode 100644 include/linux/soc/airoha/scu.h

diff --git a/Documentation/devicetree/bindings/cpufreq/airoha,en7581-cpufreq.yaml b/Documentation/devicetree/bindings/cpufreq/airoha,en7581-cpufreq.yaml
index 7d4510b..b5a9251 100644
--- a/Documentation/devicetree/bindings/cpufreq/airoha,en7581-cpufreq.yaml
+++ b/Documentation/devicetree/bindings/cpufreq/airoha,en7581-cpufreq.yaml
@@ -23,10 +23,29 @@ description: |
   CPUs can't be individually scaled as the CPU frequency is shared across
   all CPUs and is global.
 
+  EN7581 boards may opt into direct PLL control when their installed ATF
+  cannot represent the board's frequency table. Performance state numbering
+  remains 500 MHz plus 50 MHz per state, with states 0 through 18 supported.
+  This mode does not adjust the CPU supply voltage.
+
 properties:
   compatible:
     const: airoha,en7581-cpufreq
 
+  reg:
+    items:
+      - description: Chip SCU registers, including the CPU PLL
+      - description: MCU configuration registers, including clock selection
+
+  reg-names:
+    items:
+      - const: chip-scu
+      - const: mcucfg
+
+  airoha,force-direct-pll:
+    type: boolean
+    description: Use native PLL control instead of the ATF SMC service.
+
   '#clock-cells':
     const: 0
 
@@ -41,6 +60,15 @@ required:
   - '#power-domain-cells'
   - operating-points-v2
 
+allOf:
+  - if:
+      required:
+        - airoha,force-direct-pll
+    then:
+      required:
+        - reg
+        - reg-names
+
 additionalProperties: false
 
 examples:
diff --git a/drivers/pmdomain/mediatek/Kconfig b/drivers/pmdomain/mediatek/Kconfig
index 0610b77..6766dc4 100644
--- a/drivers/pmdomain/mediatek/Kconfig
+++ b/drivers/pmdomain/mediatek/Kconfig
@@ -35,6 +35,7 @@ config AIROHA_CPU_PM_DOMAIN
 	depends on HAVE_ARM_SMCCC
 	depends on PM
 	select PM_GENERIC_DOMAINS
+	select AIROHA_SCU
 	help
 	  Say y here to enable CPU power domain support for Airoha SoC.
 
diff --git a/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c b/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
index 4903a49..1aef080 100644
--- a/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
+++ b/drivers/pmdomain/mediatek/airoha-cpu-pmdomain.c
@@ -3,10 +3,15 @@
 #include <linux/arm-smccc.h>
 #include <linux/bitfield.h>
 #include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/slab.h>
+#include <linux/soc/airoha/scu.h>
+#include <linux/spinlock.h>
 
 #define AIROHA_SIP_AVS_HANDLE			0x82000301
 #define AIROHA_AVS_OP_BASE			0xddddddd0
@@ -16,11 +21,175 @@
 #define AIROHA_AVS_OP_GET_FREQ			(AIROHA_AVS_OP_BASE | \
 						 FIELD_PREP(AIROHA_AVS_OP_MASK, 0x2))
 
+#define EN7581_CPU_CLK_GATING			0x1e0
+#define EN7581_PLL_PROTECT			0x268
+#define EN7581_PLL_PROTECT_MASK			GENMASK(7, 0)
+#define EN7581_PLL_PROTECT_KEY			0x12
+#define EN7581_CPU_PCW				0x2b4
+#define EN7581_CPU_PCW_MASK			GENMASK(31, 24)
+#define EN7581_CPU_PCW_CHG			0x2b8
+#define EN7581_CPU_POSDIV_MASK			GENMASK(6, 4)
+#define EN7581_CPU_PCW_TOGGLE			BIT(0)
+#define EN7581_ACLKEN_DIV				0x640
+#define EN7581_ACLKEN_DIV_MASK			GENMASK(4, 0)
+#define EN7581_ACLKEN_DIV_HALF			0x12
+#define EN7581_BUS_PLL_DIV			0x7c0
+#define EN7581_CPU_SOURCE_MASK			GENMASK(10, 9)
+#define EN7581_CPU_DIV_MASK			GENMASK(21, 17)
+#define EN7581_CPU_ARMPLL				1
+#define EN7581_CPU_PLL2				3
+#define EN7581_CPU_MAX_STATE			18 /* 500 + 18 * 50 = 1400 MHz */
+
 struct airoha_cpu_pmdomain_priv {
 	struct clk_hw hw;
 	struct generic_pm_domain pd;
+	void __iomem *chip_scu;
+	void __iomem *mcucfg;
+	raw_spinlock_t pll_lock;
 };
 
+static unsigned long airoha_cpu_pll_get(struct airoha_cpu_pmdomain_priv *priv)
+{
+	unsigned long flags, rate = 0;
+	u32 val, pcw, posdiv;
+
+	raw_spin_lock_irqsave(&priv->pll_lock, flags);
+	val = readl(priv->mcucfg + EN7581_BUS_PLL_DIV);
+	switch (FIELD_GET(EN7581_CPU_SOURCE_MASK, val)) {
+	case 0:
+		rate = 50000000;
+		break;
+	case EN7581_CPU_ARMPLL:
+		pcw = readl(priv->chip_scu + EN7581_CPU_PCW);
+		posdiv = readl(priv->chip_scu + EN7581_CPU_PCW_CHG);
+		rate = FIELD_GET(EN7581_CPU_PCW_MASK, pcw) * 50000000UL;
+		rate >>= FIELD_GET(EN7581_CPU_POSDIV_MASK, posdiv);
+		break;
+	case 2:
+		rate = 540000000;
+		break;
+	case EN7581_CPU_PLL2:
+		rate = 400000000;
+		break;
+	}
+
+	switch (FIELD_GET(EN7581_CPU_DIV_MASK, val)) {
+	case 0:
+		break;
+	case 0xa:
+		rate /= 2;
+		break;
+	case 0xb:
+		rate /= 4;
+		break;
+	case 0x1d:
+		rate /= 6;
+		break;
+	default:
+		rate = 0;
+		break;
+	}
+	raw_spin_unlock_irqrestore(&priv->pll_lock, flags);
+
+	return rate;
+}
+
+static int airoha_cpu_pll_switch(struct airoha_cpu_pmdomain_priv *priv, u32 src)
+{
+	u32 val;
+
+	val = readl(priv->mcucfg + EN7581_BUS_PLL_DIV);
+	if (FIELD_GET(EN7581_CPU_SOURCE_MASK, val) == src)
+		return 0;
+
+	val = readl(priv->chip_scu + EN7581_CPU_CLK_GATING);
+	writel(val | BIT(src - 1), priv->chip_scu + EN7581_CPU_CLK_GATING);
+
+	/* SDK sequence: the bus follows half the CPU clock before switching. */
+	val = readl(priv->mcucfg + EN7581_ACLKEN_DIV);
+	val = (val & ~EN7581_ACLKEN_DIV_MASK) | EN7581_ACLKEN_DIV_HALF;
+	writel(val, priv->mcucfg + EN7581_ACLKEN_DIV);
+	udelay(1);
+
+	val = readl(priv->mcucfg + EN7581_BUS_PLL_DIV);
+	val &= ~EN7581_CPU_SOURCE_MASK;
+	val |= FIELD_PREP(EN7581_CPU_SOURCE_MASK, src);
+	writel(val, priv->mcucfg + EN7581_BUS_PLL_DIV);
+	val = readl(priv->mcucfg + EN7581_BUS_PLL_DIV);
+
+	return FIELD_GET(EN7581_CPU_SOURCE_MASK, val) == src ? 0 : -EIO;
+}
+
+static void airoha_cpu_pll_program(struct airoha_cpu_pmdomain_priv *priv,
+				 u32 pcw, u32 posdiv)
+{
+	u32 val;
+
+	writel(pcw, priv->chip_scu + EN7581_CPU_PCW);
+	val = readl(priv->chip_scu + EN7581_CPU_PCW_CHG);
+	val &= ~EN7581_CPU_POSDIV_MASK;
+	val |= FIELD_PREP(EN7581_CPU_POSDIV_MASK, posdiv);
+	val ^= EN7581_CPU_PCW_TOGGLE;
+	writel(val, priv->chip_scu + EN7581_CPU_PCW_CHG);
+	udelay(20);
+}
+
+static int airoha_cpu_pll_update(struct airoha_cpu_pmdomain_priv *priv,
+				 unsigned int state)
+{
+	u32 mhz = 500 + state * 50;
+	u32 posdiv = mhz < 1000;
+	u32 pcw_int = mhz / (posdiv ? 25 : 50);
+	u32 protect, gating, old_pcw, old_chg, val, pcw;
+	unsigned long flags;
+	int ret;
+
+	/* Clock readers cannot sample PCW and POSDIV from different states. */
+	raw_spin_lock_irqsave(&priv->pll_lock, flags);
+	gating = readl(priv->chip_scu + EN7581_CPU_CLK_GATING);
+	protect = readl(priv->chip_scu + EN7581_PLL_PROTECT);
+	old_pcw = readl(priv->chip_scu + EN7581_CPU_PCW);
+	old_chg = readl(priv->chip_scu + EN7581_CPU_PCW_CHG);
+	val = readl(priv->mcucfg + EN7581_BUS_PLL_DIV);
+	if (FIELD_GET(EN7581_CPU_SOURCE_MASK, val) != EN7581_CPU_ARMPLL ||
+	    FIELD_GET(EN7581_CPU_DIV_MASK, val)) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = airoha_cpu_pll_switch(priv, EN7581_CPU_PLL2);
+	if (ret)
+		goto out;
+
+	writel((protect & ~EN7581_PLL_PROTECT_MASK) | EN7581_PLL_PROTECT_KEY,
+	       priv->chip_scu + EN7581_PLL_PROTECT);
+	pcw = (old_pcw & ~EN7581_CPU_PCW_MASK) |
+	      FIELD_PREP(EN7581_CPU_PCW_MASK, pcw_int);
+	airoha_cpu_pll_program(priv, pcw, posdiv);
+
+	val = readl(priv->chip_scu + EN7581_CPU_PCW);
+	if (FIELD_GET(EN7581_CPU_PCW_MASK, val) != pcw_int)
+		ret = -EIO;
+	val = readl(priv->chip_scu + EN7581_CPU_PCW_CHG);
+	if (FIELD_GET(EN7581_CPU_POSDIV_MASK, val) != posdiv)
+		ret = -EIO;
+	if (ret)
+		airoha_cpu_pll_program(priv, old_pcw,
+				      FIELD_GET(EN7581_CPU_POSDIV_MASK, old_chg));
+
+	if (airoha_cpu_pll_switch(priv, EN7581_CPU_ARMPLL)) {
+		/* Leave PLL2 enabled if switching back failed. */
+		ret = -EIO;
+	} else {
+		writel(gating | BIT(EN7581_CPU_ARMPLL - 1),
+		       priv->chip_scu + EN7581_CPU_CLK_GATING);
+	}
+	writel(protect, priv->chip_scu + EN7581_PLL_PROTECT);
+out:
+	raw_spin_unlock_irqrestore(&priv->pll_lock, flags);
+	return ret;
+}
+
 static int airoha_cpu_pmdomain_clk_determine_rate(struct clk_hw *hw,
 						  struct clk_rate_request *req)
 {
@@ -30,8 +199,13 @@ static int airoha_cpu_pmdomain_clk_determine_rate(struct clk_hw *hw,
 static unsigned long airoha_cpu_pmdomain_clk_get(struct clk_hw *hw,
 						 unsigned long parent_rate)
 {
+	struct airoha_cpu_pmdomain_priv *priv =
+		container_of(hw, struct airoha_cpu_pmdomain_priv, hw);
 	struct arm_smccc_res res;
 
+	if (priv->chip_scu)
+		return airoha_cpu_pll_get(priv);
+
 	arm_smccc_1_1_invoke(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_GET_FREQ,
 			     0, 0, 0, 0, 0, 0, &res);
 
@@ -39,7 +213,7 @@ static unsigned long airoha_cpu_pmdomain_clk_get(struct clk_hw *hw,
 	return (int)(res.a0 * 1000 * 1000);
 }
 
-/* Airoha CPU clk SMCC is always enabled */
+/* The shared CPU clock is always enabled. */
 static int airoha_cpu_pmdomain_clk_is_enabled(struct clk_hw *hw)
 {
 	return true;
@@ -54,8 +228,23 @@ static const struct clk_ops airoha_cpu_pmdomain_clk_ops = {
 static int airoha_cpu_pmdomain_set_performance_state(struct generic_pm_domain *domain,
 						     unsigned int state)
 {
+	struct airoha_cpu_pmdomain_priv *priv =
+		container_of(domain, struct airoha_cpu_pmdomain_priv, pd);
 	struct arm_smccc_res res;
 
+	if (priv->chip_scu) {
+		int ret;
+
+		if (state > EN7581_CPU_MAX_STATE)
+			return -EINVAL;
+
+		/* Serialize against thermal mux setup using the same SCU lock. */
+		airoha_scu_lock();
+		ret = airoha_cpu_pll_update(priv, state);
+		airoha_scu_unlock();
+		return ret;
+	}
+
 	arm_smccc_1_1_invoke(AIROHA_SIP_AVS_HANDLE, AIROHA_AVS_OP_FREQ_DYN_ADJ,
 			     0, state, 0, 0, 0, 0, &res);
 
@@ -80,6 +269,30 @@ static int airoha_cpu_pmdomain_probe(struct platform_device *pdev)
 	if (!priv)
 		return -ENOMEM;
 
+	if (of_property_read_bool(dev->of_node, "airoha,force-direct-pll")) {
+		u32 val;
+
+		if (!of_device_is_compatible(dev->of_node, "airoha,en7581-cpufreq"))
+			return dev_err_probe(dev, -EINVAL,
+					     "direct PLL is only supported on EN7581\n");
+
+		priv->chip_scu = devm_platform_ioremap_resource_byname(pdev, "chip-scu");
+		if (IS_ERR(priv->chip_scu))
+			return PTR_ERR(priv->chip_scu);
+		priv->mcucfg = devm_platform_ioremap_resource_byname(pdev, "mcucfg");
+		if (IS_ERR(priv->mcucfg))
+			return PTR_ERR(priv->mcucfg);
+
+		raw_spin_lock_init(&priv->pll_lock);
+		val = readl(priv->mcucfg + EN7581_BUS_PLL_DIV);
+		if (FIELD_GET(EN7581_CPU_SOURCE_MASK, val) != EN7581_CPU_ARMPLL ||
+		    FIELD_GET(EN7581_CPU_DIV_MASK, val) || !airoha_cpu_pll_get(priv))
+			return dev_err_probe(dev, -EINVAL,
+					     "unsupported boot CPU clock configuration\n");
+
+		dev_info(dev, "using native PLL CPU frequency control\n");
+	}
+
 	/* Init and register a get-only clk for Cpufreq */
 	priv->hw.init = &init;
 	ret = devm_clk_hw_register(dev, &priv->hw);
