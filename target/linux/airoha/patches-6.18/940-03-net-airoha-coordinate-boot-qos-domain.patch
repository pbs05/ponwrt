diff --git a/drivers/net/ethernet/airoha/airoha_qos.c b/drivers/net/ethernet/airoha/airoha_qos.c
new file mode 100644
index 0000000..dacb5d0
--- /dev/null
+++ b/drivers/net/ethernet/airoha/airoha_qos.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/module.h>
+#include <linux/rtnetlink.h>
+#include <net/airoha_qos.h>
+
+static LIST_HEAD(airoha_qos_domains);
+
+void airoha_qos_register(struct airoha_qos_domain *d,
+			 const struct airoha_qos_ops *ops, void *priv)
+{
+	rtnl_lock();
+	d->ops[0] = ops;
+	d->priv[0] = priv;
+	airoha_qos_default_profile(&d->profile);
+	d->profile.dscp = false;
+	list_add_tail(&d->list, &airoha_qos_domains);
+	rtnl_unlock();
+}
+EXPORT_SYMBOL_GPL(airoha_qos_register);
+
+void airoha_qos_unregister(struct airoha_qos_domain *d)
+{
+	rtnl_lock();
+	list_del(&d->list);
+	rtnl_unlock();
+}
+EXPORT_SYMBOL_GPL(airoha_qos_unregister);
+
+static struct airoha_qos_domain *airoha_qos_find(struct net_device *dev)
+{
+	struct airoha_qos_domain *d;
+
+	ASSERT_RTNL();
+	list_for_each_entry(d, &airoha_qos_domains, list)
+		if (d->ops[0]->owns(d->priv[0], dev))
+			return d;
+	return NULL;
+}
+
+int airoha_qos_switch_register(struct net_device *conduit,
+			      const struct airoha_qos_ops *ops, void *priv)
+{
+	struct airoha_qos_domain *d;
+	int err = 0;
+
+	rtnl_lock();
+	d = airoha_qos_find(conduit);
+	if (!d)
+		err = -EOPNOTSUPP;
+	else if (d->ops[1] || d->frozen)
+		err = -EBUSY;
+	else {
+		d->ops[1] = ops;
+		d->priv[1] = priv;
+	}
+	rtnl_unlock();
+	return err;
+}
+EXPORT_SYMBOL_GPL(airoha_qos_switch_register);
+
+void airoha_qos_switch_unregister(struct net_device *conduit, void *priv)
+{
+	struct airoha_qos_domain *d;
+
+	rtnl_lock();
+	d = airoha_qos_find(conduit);
+	if (d && d->priv[1] == priv) {
+		/* An active domain cannot silently lose its switch participant. */
+		d->broken |= d->active;
+		d->ops[1] = NULL;
+		d->priv[1] = NULL;
+	}
+	rtnl_unlock();
+}
+EXPORT_SYMBOL_GPL(airoha_qos_switch_unregister);
+
+MODULE_DESCRIPTION("Airoha coordinated boot QoS domain");
+MODULE_LICENSE("GPL");
