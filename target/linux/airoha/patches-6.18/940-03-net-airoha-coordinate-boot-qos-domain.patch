+/* One profile per FE/QDMA/switch domain. RTNL serializes registration and
+ * application; no packet-path locks or dynamic updates are needed. */
+struct airoha_qos_ops {
+	void (*lock)(void *priv);
+	void (*unlock)(void *priv);
+	bool (*owns)(void *priv, const struct net_device *dev);
+	int (*idle)(void *priv);
+	int (*save)(void *priv);
+	int (*apply)(void *priv, const struct airoha_qos_profile *profile);
+	int (*restore)(void *priv);
+};
+
+struct airoha_qos_domain {
+	struct list_head list;
+	struct airoha_qos_profile profile;
+	const struct airoha_qos_ops *ops[2];
+	void *priv[2];
+	/* broken rejects new QoS transactions, never basic interface opens. */
+	bool active, frozen, broken;
+};
+
+static inline int airoha_qos_commit(struct airoha_qos_domain *d,
+				   const struct airoha_qos_profile *p)
+{
+	int i, err, restore_err = 0;
+
+	if (d->broken)
+		return -EIO;
+	if (d->frozen)
+		return -EPERM;
+	for (i = 0; i < 64; i++)
+		if (p->map[i] > 7)
+			return -EINVAL;
+	if (!d->ops[0] || (p->dscp && !d->ops[1]))
+		return -ENODEV;
+	if (d->ops[0]->lock)
+		d->ops[0]->lock(d->priv[0]);
+	for (i = 0; i < 2; i++) {
+		if (!d->ops[i])
+			continue;
+		err = d->ops[i]->idle(d->priv[i]);
+		if (err)
+			goto out;
+	}
+	if (!p->dscp)
+		goto commit;
+	for (i = 0; i < 2; i++) {
+		err = d->ops[i]->save(d->priv[i]);
+		if (err)
+			goto out;
+	}
+	for (i = 0; i < 2; i++) {
+		err = d->ops[i]->apply(d->priv[i], p);
+		if (err)
+			goto rollback;
+	}
+commit:
+	d->profile = *p;
+	/* Interfaces are down under RTNL. Publish only after all readbacks. */
+	WRITE_ONCE(d->active, p->dscp);
+	d->frozen = true;
+	err = 0;
+	goto out;
+rollback:
+	for (; i >= 0; i--)
+		restore_err |= d->ops[i]->restore(d->priv[i]);
+	/* No data interface has opened and no active map was published. A
+	 * partial QoS rollback must not disable the management network. These
+	 * transactions never own port state, VLAN membership or forwarding ACLs.
+	 */
+	d->profile.dscp = false;
+	WRITE_ONCE(d->active, false);
+	if (restore_err) {
+		d->broken = true;
+		d->frozen = true;
+	}
+out:
+	if (d->ops[0]->unlock)
+		d->ops[0]->unlock(d->priv[0]);
+	return err;
+}
