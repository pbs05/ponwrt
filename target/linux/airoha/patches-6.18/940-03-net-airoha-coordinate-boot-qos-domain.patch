+static bool airoha_qos_owns(void *priv, const struct net_device *netdev)
+{
+	struct airoha_eth *eth = priv;
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++)
+			if (port->devs[j] && netdev_from_priv(port->devs[j]) == netdev)
+				return true;
+	}
+	return false;
