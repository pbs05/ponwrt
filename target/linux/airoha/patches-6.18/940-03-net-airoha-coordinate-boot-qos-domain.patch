From: Huajin Wang <7976028+excelwang@users.noreply.github.com>
Subject: [PATCH] net: airoha: coordinate boot QoS domain and failure containment

Export retained coordinated FE/QDMA/MT7530 QoS setup onto current
PonWrt. Preserve current DSA statistics fields and LRO admission logic;
use test_bit() for the current WAN/PON/TX_QOS device flag indices.
Apply, rollback and optional-fault containment retain their original
scopes and ownership.

---
diff --git a/drivers/net/dsa/Kconfig b/drivers/net/dsa/Kconfig
index e6f18ed..afc6150 100644
--- a/drivers/net/dsa/Kconfig
+++ b/drivers/net/dsa/Kconfig
@@ -40,6 +40,11 @@ config NET_DSA_MT7530
 	  MT7621ST and MT7623AI SoCs, and built-in switch in MT7988 SoC are
 	  supported as well.
 
+config NET_DSA_MT7530_KUNIT_TEST
+	bool "EN7581 QoS register tests" if !KUNIT_ALL_TESTS
+	depends on KUNIT && NET_DSA_MT7530
+	default KUNIT_ALL_TESTS
+
 config NET_DSA_MT7530_MDIO
 	tristate "MediaTek MT7530 MDIO interface driver"
 	depends on NET_DSA_MT7530
diff --git a/drivers/net/dsa/mt7530.c b/drivers/net/dsa/mt7530.c
index 2bf9604..01ee98a 100644
--- a/drivers/net/dsa/mt7530.c
+++ b/drivers/net/dsa/mt7530.c
@@ -24,6 +24,10 @@
 #include <net/pkt_cls.h>
 
 #include "mt7530.h"
+#include <net/airoha_qos.h>
+#if IS_ENABLED(CONFIG_NET_DSA_MT7530_KUNIT_TEST)
+#include <kunit/test.h>
+#endif
 
 #define MT7530_STATS_POLL_INTERVAL	(1 * HZ)
 #define MT7530_STATS_RATE_LIMIT		(HZ / 10)
@@ -3341,9 +3345,232 @@ static int mt753x_setup_tc(struct dsa_switch *ds, int port,
 	}
 }
 
+
+#define EN7581_QOS_REG_COUNT (12 + MT7530_NUM_PORTS * 16)
+struct en7581_qos_state {
+	struct net_device *conduit;
+	struct airoha_qos_profile profile;
+	u32 saved[EN7581_QOS_REG_COUNT];
+	u32 changed[EN7581_QOS_REG_COUNT];
+	u32 ports;
+	bool active, broken;
+};
+
+static u32 en7581_qos_reg(int index)
+{
+	if (!index)
+		return EN7581_UPW;
+	if (index < 5)
+		return EN7581_PEM((index - 1) * 2);
+	if (index < 12)
+		return EN7581_PIM((index - 5) * 10);
+	index -= 12;
+	return EN7581_MMSCR0(index / 16, index % 16 / 2) + (index % 2) * 4;
+}
+
+static u32 en7581_qos_reg_mask(struct mt7530_priv *priv, int index)
+{
+	if (!index)
+		return EN7581_UPW_MASK;
+	if (index < 5)
+		return GENMASK(10, 8) | GENMASK(26, 24);
+	if (index < 11)
+		return GENMASK(29, 0);
+	if (index == 11)
+		return GENMASK(11, 0); /* DSCP 60..63 only. */
+	if (!(priv->qos->ports & BIT((index - 12) / 16)))
+		return 0;
+	/* The SDK SP profile owns both complete scheduler configuration words. */
+	return U32_MAX;
+}
+
+static int en7581_qos_update(struct mt7530_priv *priv, u32 reg, u32 mask, u32 value)
+{
+	u32 readback;
+	int err = regmap_update_bits(priv->regmap, reg, mask, value);
+
+	if (err)
+		return err;
+	err = regmap_read(priv->regmap, reg, &readback);
+	return err ?: ((readback & mask) == value ? 0 : -EIO);
+}
+
+static int en7581_qos_write(struct mt7530_priv *priv, int index, u32 mask,
+			     u32 value)
+{
+	mask &= en7581_qos_reg_mask(priv, index);
+	/* A failed bus write can still have changed the device. */
+	priv->qos->changed[index] |= mask;
+	return en7581_qos_update(priv, en7581_qos_reg(index), mask, value & mask);
+}
+
+static int en7581_qos_idle(void *ctx)
+{
+	struct mt7530_priv *priv = ctx;
+	struct dsa_port *dp;
+	u32 value;
+	int err;
+
+	dsa_switch_for_each_user_port(dp, priv->ds) {
+		if (!dp->user || netif_running(dp->user) || dsa_port_bridge_dev_get(dp))
+			return -EBUSY;
+		err = regmap_read(priv->regmap, MT7530_PCR_P(dp->index), &value);
+		if (err)
+			return err;
+		if (value & PCR_MATRIX(dsa_user_ports(priv->ds)))
+			return -EBUSY;
+	}
+	return 0;
+}
+
+static int en7581_qos_save(void *ctx)
+{
+	struct mt7530_priv *priv = ctx;
+	int i, err;
+
+	memset(priv->qos->changed, 0, sizeof(priv->qos->changed));
+	for (i = 0; i < EN7581_QOS_REG_COUNT; i++) {
+		if (!en7581_qos_reg_mask(priv, i))
+			continue;
+		err = regmap_read(priv->regmap, en7581_qos_reg(i), &priv->qos->saved[i]);
+		if (err)
+			return err;
+	}
+	return 0;
+}
+
+static int en7581_qos_restore(void *ctx)
+{
+	struct mt7530_priv *priv = ctx;
+	int i, ret, err = 0;
+
+	for (i = EN7581_QOS_REG_COUNT - 1; i >= 0; i--) {
+		u32 mask = priv->qos->changed[i];
+
+		if (!mask)
+			continue;
+		ret = en7581_qos_update(priv, en7581_qos_reg(i), mask,
+					priv->qos->saved[i] & mask);
+		if (ret)
+			err = ret;
+		else
+			priv->qos->changed[i] = 0;
+	}
+	priv->qos->active = false;
+	priv->qos->broken |= !!err;
+	return err;
+}
+
+static int en7581_qos_apply(void *ctx, const struct airoha_qos_profile *profile)
+{
+	struct mt7530_priv *priv = ctx;
+	int port, q, dscp, err;
+
+	if (priv->id != ID_EN7581)
+		return -EOPNOTSUPP;
+	for (q = 0; q < 8; q++) {
+		u32 shift = EN7581_PEM_Q_SHIFT(q);
+
+		/* Wire PCP and DSCP remarking fields remain unchanged. */
+		err = en7581_qos_write(priv, 1 + q / 2, 7 << shift, q << shift);
+		if (err)
+			return err;
+	}
+	for (dscp = 0; dscp < 64; dscp++) {
+		u32 shift = EN7581_PIM_SHIFT(dscp);
+
+		err = en7581_qos_write(priv, 5 + dscp / 10, 7 << shift,
+					profile->map[dscp] << shift);
+		if (err)
+			return err;
+	}
+	err = en7581_qos_write(priv, 0, EN7581_UPW_MASK,
+				EN7581_UPW_STAG_DSCP_PCP);
+	if (err)
+		return err;
+	for (port = 0; port < MT7530_NUM_PORTS; port++) {
+		if (!(priv->qos->ports & BIT(port)))
+			continue;
+		for (q = 0; q < 8; q++) {
+			err = en7581_qos_write(priv, 12 + port * 16 + q * 2,
+						U32_MAX, EN7581_MMSCR_SP);
+			if (err)
+				return err;
+			err = en7581_qos_write(priv, 13 + port * 16 + q * 2, U32_MAX, 0);
+			if (err)
+				return err;
+		}
+	}
+	priv->qos->profile = *profile;
+	priv->qos->active = true;
+	return 0;
+}
+
+static const struct airoha_qos_ops en7581_qos_ops = {
+	.idle = en7581_qos_idle, .save = en7581_qos_save,
+	.apply = en7581_qos_apply, .restore = en7581_qos_restore,
+};
+
+static int en7581_qos_register(struct dsa_switch *ds)
+{
+	struct mt7530_priv *priv = ds->priv;
+	struct dsa_port *dp;
+	int err;
+
+	if (priv->id != ID_EN7581)
+		return 0;
+	if (priv->qos) {
+		if (!priv->qos->active)
+			return 0;
+		/* Snapshot the fresh hardware baseline, not the pre-reset state. */
+		err = en7581_qos_save(priv);
+		if (!err) {
+			err = en7581_qos_apply(priv, &priv->qos->profile);
+			if (err)
+				en7581_qos_restore(priv);
+		}
+		if (err) {
+			priv->qos->active = false;
+			priv->qos->broken = true;
+			if (priv->qos->conduit)
+				airoha_qos_switch_unregister(priv->qos->conduit, priv);
+			priv->qos->conduit = NULL;
+		}
+		return err;
+	}
+	priv->qos = devm_kzalloc(priv->dev, sizeof(*priv->qos), GFP_KERNEL);
+	if (!priv->qos)
+		return -ENOMEM;
+	dsa_switch_for_each_port(dp, ds)
+		if (!dsa_port_is_unused(dp))
+			priv->qos->ports |= BIT(dp->index);
+	dsa_switch_for_each_cpu_port(dp, ds) {
+		err = airoha_qos_switch_register(dp->conduit, &en7581_qos_ops, priv);
+		if (err == -EOPNOTSUPP)
+			continue;
+		if (err)
+			return err;
+		priv->qos->conduit = dp->conduit;
+		break;
+	}
+	return 0;
+}
+
+static void mt753x_qos_teardown(struct dsa_switch *ds)
+{
+	struct mt7530_priv *priv = ds->priv;
+
+	mt753x_teardown(ds);
+	if (priv->qos && priv->qos->conduit) {
+		airoha_qos_switch_unregister(priv->qos->conduit, priv);
+		priv->qos->conduit = NULL;
+	}
+}
+
 static int mt7988_setup(struct dsa_switch *ds)
 {
 	struct mt7530_priv *priv = ds->priv;
+	int err;
 
 	/* Reset the switch */
 	reset_control_assert(priv->rstc);
@@ -3364,13 +3591,25 @@ static int mt7988_setup(struct dsa_switch *ds)
 	/* Reset the switch PHYs */
 	mt7530_write(priv, MT7530_SYS_CTRL, SYS_CTRL_PHY_RST);
 
-	return mt7531_setup_common(ds);
+	err = mt7531_setup_common(ds);
+	if (err)
+		return err;
+	err = en7581_qos_register(ds);
+	if (err)
+		dev_warn(priv->dev,
+			 "Optional QoS setup failed (%d); continuing switch initialization\n",
+			 err);
+	return 0;
 }
 
+#if IS_ENABLED(CONFIG_NET_DSA_MT7530_KUNIT_TEST)
+#include "mt7530_qos_test.h"
+#endif
+
 const struct dsa_switch_ops mt7530_switch_ops = {
 	.get_tag_protocol	= mtk_get_tag_protocol,
 	.setup			= mt753x_setup,
-	.teardown		= mt753x_teardown,
+	.teardown		= mt753x_qos_teardown,
 	.preferred_default_local_cpu_port = mt753x_preferred_default_local_cpu_port,
 	.get_strings		= mt7530_get_strings,
 	.get_ethtool_stats	= mt7530_get_ethtool_stats,
diff --git a/drivers/net/dsa/mt7530.h b/drivers/net/dsa/mt7530.h
index ca665f8..efecb6d 100644
--- a/drivers/net/dsa/mt7530.h
+++ b/drivers/net/dsa/mt7530.h
@@ -11,6 +11,19 @@
 #define MT7530_NUM_FDB_RECORDS		2048
 #define MT7530_ALL_MEMBERS		0xff
 
+/* EN7581 priority arbitration, classification and egress scheduler. */
+#define EN7581_UPW			0x44
+#define EN7581_UPW_MASK			0x777777
+#define EN7581_UPW_STAG_DSCP_PCP		0x126372
+#define EN7581_PEM(p)			(0x48 + ((p) / 2) * 4)
+#define EN7581_PEM_Q_SHIFT(p)		(8 + ((p) % 2) * 16)
+#define EN7581_PIM(dscp)			(0x58 + ((dscp) / 10) * 4)
+#define EN7581_PIM_SHIFT(dscp)		(((dscp) % 10) * 3)
+#define EN7581_PORT_PRIO			GENMASK(26, 24)
+#define EN7581_MMSCR0(p, q)		(0x1000 + (p) * 0x100 + (q) * 8)
+#define EN7581_MMSCR1(p, q)		(EN7581_MMSCR0(p, q) + 4)
+#define EN7581_MMSCR_SP			BIT(31)
+
 #define MTK_HDR_LEN	4
 #define MT7530_MAX_MTU	(15 * 1024 - ETH_HLEN - ETH_FCS_LEN - MTK_HDR_LEN)
 
@@ -882,7 +895,10 @@ struct mt753x_info {
  * @stats_work:		Delayed work for polling MIB counters on MDIO switches
  * @stats_last:		Jiffies timestamp of last MIB counter poll
  */
+struct en7581_qos_state;
+
 struct mt7530_priv {
+	struct en7581_qos_state *qos;
 	struct device		*dev;
 	struct dsa_switch	*ds;
 	struct mii_bus		*bus;
diff --git a/drivers/net/dsa/mt7530_qos_test.h b/drivers/net/dsa/mt7530_qos_test.h
new file mode 100644
index 0000000..b125c73
--- /dev/null
+++ b/drivers/net/dsa/mt7530_qos_test.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included so tests exercise the actual static initialization/DCB code. */
+struct en7581_test_regs {
+	u32 words[0x8000 / 4];
+	u32 fail_reg;
+	u32 fail_read_reg;
+	u32 ignore_reg;
+	u32 ports;
+};
+
+static int en7581_test_read(void *ctx, unsigned int reg, unsigned int *val)
+{
+	struct en7581_test_regs *regs = ctx;
+
+	if (reg == regs->fail_read_reg)
+		return -EIO;
+	if (reg >= 0x1000 && reg < 0x1700 &&
+	    !(regs->ports & BIT((reg - 0x1000) / 0x100)))
+		return -EIO;
+	*val = regs->words[reg / 4];
+	return 0;
+}
+
+static int en7581_test_write(void *ctx, unsigned int reg, unsigned int val)
+{
+	struct en7581_test_regs *regs = ctx;
+
+	if (reg == regs->fail_reg)
+		return -EIO;
+	if (reg == regs->ignore_reg)
+		return 0;
+	regs->words[reg / 4] = val;
+	return 0;
+}
+
+static void en7581_test_regmap_exit(void *map)
+{
+	regmap_exit(map);
+}
+
+static void en7581_qos_register_test(struct kunit *test)
+{
+	static const struct regmap_bus bus = {
+		.reg_read = en7581_test_read,
+		.reg_write = en7581_test_write,
+	};
+	static const struct regmap_config config = {
+		.reg_bits = 32, .val_bits = 32, .reg_stride = 4,
+		.max_register = 0x7ffc,
+	};
+	struct en7581_test_regs *regs;
+	struct mt7530_priv *priv;
+	struct dsa_switch *ds;
+	struct dsa_switch_tree dst = {};
+	struct dsa_port user = {}, cpu = {};
+	int dscp, port, queue;
+	struct airoha_qos_profile profile;
+
+	regs = kunit_kzalloc(test, sizeof(*regs), GFP_KERNEL);
+	priv = kunit_kzalloc(test, sizeof(*priv), GFP_KERNEL);
+	ds = kunit_kzalloc(test, sizeof(*ds), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, regs);
+	KUNIT_ASSERT_NOT_NULL(test, priv);
+	KUNIT_ASSERT_NOT_NULL(test, ds);
+	regs->fail_reg = U32_MAX;
+	regs->fail_read_reg = U32_MAX;
+	regs->ignore_reg = U32_MAX;
+	regs->ports = GENMASK(4, 2) | BIT(5);
+	priv->regmap = regmap_init(NULL, &bus, regs, &config);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, priv->regmap);
+	KUNIT_ASSERT_EQ(test, kunit_add_action_or_reset(test,
+			       en7581_test_regmap_exit, priv->regmap), 0);
+	priv->id = ID_EN7581;
+	priv->qos = kunit_kzalloc(test, sizeof(*priv->qos), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, priv->qos);
+	priv->qos->ports = regs->ports;
+	airoha_qos_default_profile(&profile);
+	ds->priv = priv;
+	for (queue = 0; queue < 4; queue++)
+		regs->words[EN7581_PEM(queue * 2) / 4] = 0x383f383f;
+	KUNIT_ASSERT_EQ(test, en7581_qos_save(priv), 0);
+	KUNIT_ASSERT_EQ(test, en7581_qos_apply(priv, &profile), 0);
+	for (queue = 0; queue < 8; queue++) {
+		u32 value = regs->words[EN7581_PEM(queue) / 4];
+
+		KUNIT_EXPECT_EQ(test, (value >> EN7581_PEM_Q_SHIFT(queue)) & 7,
+				(u32)queue);
+		KUNIT_EXPECT_EQ(test, value & 0x383f383f, (u32)0x383f383f);
+	}
+	for (dscp = 0; dscp < 64; dscp++)
+		KUNIT_EXPECT_EQ(test, (regs->words[EN7581_PIM(dscp) / 4] >> EN7581_PIM_SHIFT(dscp)) & 7,
+				(u32)profile.map[dscp]);
+	for (port = 0; port < MT7530_NUM_PORTS; port++) {
+		if (!(regs->ports & BIT(port)))
+			continue;
+		for (queue = 0; queue < 8; queue++) {
+			KUNIT_EXPECT_EQ(test, regs->words[EN7581_MMSCR0(port, queue) / 4],
+					(u32)EN7581_MMSCR_SP);
+			KUNIT_EXPECT_EQ(test, regs->words[EN7581_MMSCR1(port, queue) / 4], 0);
+		}
+	}
+	KUNIT_EXPECT_EQ(test, en7581_qos_restore(priv), 0);
+	for (queue = 0; queue < 4; queue++)
+		KUNIT_EXPECT_EQ(test, regs->words[EN7581_PEM(queue * 2) / 4],
+				(u32)0x383f383f);
+	regs->fail_reg = EN7581_PIM(63);
+	KUNIT_EXPECT_EQ(test, en7581_qos_apply(priv, &profile), -EIO);
+	regs->fail_reg = U32_MAX;
+	/* Failure before UPW/scheduler writes must not read or restore them. */
+	regs->fail_read_reg = EN7581_UPW;
+	/* Unowned/reserved bits may change independently after the snapshot. */
+	regs->words[EN7581_PIM(63) / 4] |= BIT(31);
+	regs->words[EN7581_PEM(0) / 4] ^= BIT(0);
+	KUNIT_ASSERT_EQ(test, en7581_qos_restore(priv), 0);
+	KUNIT_EXPECT_EQ(test, regs->words[EN7581_PIM(63) / 4] & BIT(31), BIT(31));
+	KUNIT_EXPECT_EQ(test, regs->words[EN7581_PEM(0) / 4] & BIT(0), 0);
+	regs->fail_read_reg = U32_MAX;
+	regs->ignore_reg = EN7581_PIM(7);
+	KUNIT_EXPECT_EQ(test, en7581_qos_apply(priv, &profile), -EIO);
+	regs->ignore_reg = U32_MAX;
+	KUNIT_ASSERT_EQ(test, en7581_qos_apply(priv, &profile), 0);
+	/* Same stored profile can restore all mappings after a reset. */
+	memset(regs->words, 0, sizeof(regs->words));
+	KUNIT_EXPECT_EQ(test, en7581_qos_apply(priv, &priv->qos->profile), 0);
+	priv->id = ID_MT7530;
+	KUNIT_EXPECT_EQ(test, en7581_qos_apply(priv, &profile), -EOPNOTSUPP);
+	KUNIT_EXPECT_TRUE(test, !mt7530_switch_ops.port_get_dscp_prio);
+
+	/* A failed QoS rollback must not disable ordinary DSA port opening. */
+	priv->id = ID_EN7581;
+	priv->ds = ds;
+	priv->qos->broken = true;
+	mutex_init(&priv->reg_mutex);
+	ds->dst = &dst;
+	INIT_LIST_HEAD(&dst.ports);
+	user.ds = cpu.ds = ds;
+	user.index = 2;
+	user.type = DSA_PORT_TYPE_USER;
+	user.cpu_dp = &cpu;
+	cpu.index = 5;
+	cpu.type = DSA_PORT_TYPE_CPU;
+	list_add_tail(&user.list, &dst.ports);
+	list_add_tail(&cpu.list, &dst.ports);
+	KUNIT_EXPECT_EQ(test, mt7530_port_enable(ds, 2, NULL), 0);
+	KUNIT_EXPECT_TRUE(test, priv->ports[2].enable);
+	KUNIT_EXPECT_EQ(test,
+		regs->words[MT7530_PCR_P(2) / 4] & PCR_MATRIX_MASK,
+		(u32)PCR_MATRIX(BIT(5)));
+}
+
+static struct kunit_case en7581_qos_cases[] = {
+	KUNIT_CASE(en7581_qos_register_test),
+	{}
+};
+
+static struct kunit_suite en7581_qos_suite = {
+	.name = "en7581-qos-registers",
+	.test_cases = en7581_qos_cases,
+};
+
+kunit_test_suite(en7581_qos_suite);
diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
index acc4404..00cb856 100644
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -14,9 +14,14 @@ config NET_AIROHA_PRIORITY_KUNIT_TEST
 
 if NET_VENDOR_AIROHA
 
+config NET_AIROHA_QOS
+	tristate
+	depends on INET
+
 config NET_AIROHA_QOS_KUNIT_TEST
 	tristate "Airoha QoS metadata tests" if !KUNIT_ALL_TESTS
 	depends on KUNIT && INET
+	select NET_AIROHA_QOS
 	default KUNIT_ALL_TESTS
 	help
 	  Test hardware channel/ring separation and QoS metadata without hardware.
@@ -32,6 +37,7 @@ config NET_AIROHA_NPU
 config NET_AIROHA
 	tristate "Airoha SoC Gigabit Ethernet support"
 	depends on NET_DSA || !NET_DSA
+	select NET_AIROHA_QOS
 	select NET_AIROHA_NPU
 	select PAGE_POOL
 	select PCS_AIROHA
diff --git a/drivers/net/ethernet/airoha/Makefile b/drivers/net/ethernet/airoha/Makefile
index 1ddf258..a8b7b0b 100644
--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -10,3 +10,4 @@ airoha-eth-y := airoha_eth.o airoha_ppe.o
 airoha-eth-$(CONFIG_DEBUG_FS) += airoha_ppe_debugfs.o
 obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
 obj-$(CONFIG_NET_AIROHA_QOS_KUNIT_TEST) += airoha_qos_test.o
+obj-$(CONFIG_NET_AIROHA_QOS) += airoha_qos.o
