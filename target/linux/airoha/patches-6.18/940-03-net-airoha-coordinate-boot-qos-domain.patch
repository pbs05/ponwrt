+
+struct airoha_mock {
+	int idle, save, apply, restore, writes, restores;
+};
+static int mock_idle(void *p) { return ((struct airoha_mock *)p)->idle; }
+static int mock_save(void *p) { return ((struct airoha_mock *)p)->save; }
+static int mock_apply(void *p, const struct airoha_qos_profile *profile)
+{
+	struct airoha_mock *m = p;
+
+	m->writes++;
+	return m->apply;
+}
+static int mock_restore(void *p)
+{
+	struct airoha_mock *m = p;
+
+	m->restores++;
+	return m->restore;
+}
+static const struct airoha_qos_ops mock_ops = {
+	.idle = mock_idle, .save = mock_save,
+	.apply = mock_apply, .restore = mock_restore,
+};
+static void airoha_transaction_test(struct kunit *test)
+{
+	struct airoha_mock cpu = {}, sw = {};
+	struct airoha_qos_domain d = { .ops = { &mock_ops, &mock_ops },
+		.priv = { &cpu, &sw } };
+	struct airoha_qos_profile p;
+
+	airoha_qos_default_profile(&p);
+	/* preinit use does not freeze: once down, application may succeed. */
+	cpu.idle = -EBUSY;
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EBUSY);
+	KUNIT_EXPECT_FALSE(test, d.frozen);
+	KUNIT_EXPECT_EQ(test, cpu.writes, 0);
+	cpu.idle = 0;
+	sw.save = -EIO;
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EIO);
+	KUNIT_EXPECT_EQ(test, cpu.writes, 0);
+	sw.save = 0;
+	sw.apply = -EIO;
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EIO);
+	KUNIT_EXPECT_EQ(test, cpu.restores, 1);
+	KUNIT_EXPECT_EQ(test, sw.restores, 1);
+	KUNIT_EXPECT_FALSE(test, d.active);
+	KUNIT_EXPECT_FALSE(test, d.broken);
+	sw.apply = 0;
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), 0);
+	KUNIT_EXPECT_TRUE(test, d.active);
+	KUNIT_EXPECT_TRUE(test, d.frozen);
+	KUNIT_EXPECT_MEMEQ(test, d.profile.map, p.map, 64);
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EPERM);
+	d.frozen = d.active = false;
+	sw.apply = -EIO;
+	cpu.restore = -EIO;
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EIO);
+	KUNIT_EXPECT_TRUE(test, d.broken);
+	KUNIT_EXPECT_FALSE(test, d.active);
+	KUNIT_EXPECT_FALSE(test, d.profile.dscp);
+	KUNIT_EXPECT_TRUE(test, d.frozen);
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EIO);
+}
+
+static void airoha_transaction_validation_test(struct kunit *test)
+{
+	struct airoha_mock cpu = {}, sw = {};
+	struct airoha_qos_domain d = { .ops = { &mock_ops, NULL },
+		.priv = { &cpu, &sw } };
+	struct airoha_qos_profile p;
+
+	airoha_qos_default_profile(&p);
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -ENODEV);
+	d.ops[1] = &mock_ops;
+	p.map[63] = 8;
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EINVAL);
+	KUNIT_EXPECT_EQ(test, cpu.writes, 0);
+	p.map[63] = 0;
+	sw.idle = -EBUSY;
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EBUSY);
+	KUNIT_EXPECT_EQ(test, cpu.writes, 0);
+	sw.idle = 0;
+	p.dscp = false;
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), 0);
+	KUNIT_EXPECT_FALSE(test, d.active);
+	KUNIT_EXPECT_TRUE(test, d.frozen);
+	KUNIT_EXPECT_EQ(test, cpu.writes, 0);
+	KUNIT_EXPECT_EQ(test, sw.writes, 0);
+	KUNIT_EXPECT_EQ(test, airoha_qos_commit(&d, &p), -EPERM);
+}
