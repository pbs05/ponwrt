+			    (test_bit(AIROHA_DEV_F_WAN, &dev->flags) ||
+			     (port->id != 1 && (port->id != 4 || dev->nbq))))
+				return -EOPNOTSUPP;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++) {
+		struct airoha_qdma *qdma = &eth->qdma[i];
+
+		if (!bitmap_empty(qdma->qos_channel_map, AIROHA_NUM_QOS_CHANNELS))
+			return -EBUSY;
+		for (j = 0; j < AIROHA_NUM_QOS_CHANNELS; j++)
+			if (qdma->ets_owner[j].netdev || qdma->ets_owner[j].broken)
+				return -EBUSY;
+		for (j = 0; j < ARRAY_SIZE(qdma->q_tx); j++) {
+			struct airoha_queue *q = &qdma->q_tx[j];
+			bool busy;
+
+			spin_lock_bh(&q->lock);
+			busy = q->queued;
+			spin_unlock_bh(&q->lock);
+			if (busy)
+				return -EBUSY;
+		}
+	}
+	return airoha_ppe_qos_idle(eth);
