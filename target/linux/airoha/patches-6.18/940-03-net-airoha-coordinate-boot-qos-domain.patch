+static int airoha_qos_idle(void *priv)
+{
+	struct airoha_eth *eth = priv;
+	int i, j;
+
+	ASSERT_RTNL();
+	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+		struct airoha_gdm_port *port = eth->ports[i];
+
+		if (!port)
+			continue;
+		for (j = 0; j < ARRAY_SIZE(port->devs); j++) {
+			struct airoha_gdm_dev *dev = port->devs[j];
+
+			if (!dev)
+				continue;
+			if (netif_running(netdev_from_priv(dev)) ||
+			    test_bit(AIROHA_DEV_F_TX_QOS, &dev->flags))
+				return -EBUSY;
