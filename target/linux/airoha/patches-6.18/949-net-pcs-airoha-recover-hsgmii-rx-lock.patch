+++ b/drivers/net/pcs/airoha/pcs-airoha-recovery.c
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Bounded AN7581 Ethernet HSGMII recovery; never runs in the packet path. */
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/workqueue.h>
+
+#include "pcs-airoha.h"
+
+#define AIROHA_PCS_HEALTH_MS	1000
+#define AIROHA_PCS_CONFIRM_MS	100
+#define AIROHA_PCS_COOLDOWN_MS	30000
+#define AIROHA_PCS_RECOVERY_TRIES	3
+#define AIROHA_PCS_SIGDET_MUX	GENMASK(31, 16)
+
+/* The caller holds port->lock, including when temporarily using the mux. */
+static int airoha_pcs_hsgmii_signal(struct airoha_pcs_port *port, bool *present)
+{
+	struct regmap *pma = port->priv->pcs_pma[port->index];
+	u32 saved, val;
+	int ret, restore, count = 0, i;
+
+	ret = regmap_read(pma, AIROHA_PCS_PMA_DIG_RESERVE_0, &saved);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(pma, AIROHA_PCS_PMA_DIG_RESERVE_0,
+				 AIROHA_PCS_SIGDET_MUX,
+				 FIELD_PREP(AIROHA_PCS_SIGDET_MUX, 3));
+	if (ret)
+		goto restore;
+
+	/* Same six samples / four positives as the SDK, only after a fault. */
+	for (i = 0; i < AIROHA_PCS_MAX_RX_SIGDET_TRY; i++) {
+		ret = regmap_read(pma, AIROHA_PCS_PMA_DIG_RO_RESERVE_2, &val);
+		if (ret)
+			break;
+		count += !!(val & AIROHA_PCS_RX_SIGDET);
+	}
+
+restore:
+	restore = regmap_update_bits(pma, AIROHA_PCS_PMA_DIG_RESERVE_0,
+				     AIROHA_PCS_SIGDET_MUX, saved);
+	if (ret || restore)
+		return ret ? ret : restore;
+
+	*present = count >= AIROHA_PCS_MAX_RX_SIGDET_PRESENCE_CNT;
+	return 0;
+}
+
+static int airoha_pcs_hsgmii_relock(struct airoha_pcs_port *port)
+{
+	struct regmap *pma = port->priv->pcs_pma[port->index];
+	u32 l2d = AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_LCK2DATA |
+		  AIROHA_PCS_PMA_FORCE_DA_CDR_LPF_LCK2DATA;
+	u32 rst = AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_RSTB |
+		  AIROHA_PCS_PMA_FORCE_DA_CDR_LPF_RSTB;
+	u32 reg = AIROHA_PCS_PMA_PXP_CDR_LPF_LCK_2DATA;
+	u32 saved;
+	int ret;
+
+	ret = regmap_read(pma, reg, &saved);
+	if (ret)
+		return ret;
+	/* Do not override an intentional, externally forced PMA state. */
+	if (saved & (AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_RSTB |
+		     AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_LCK2DATA))
+		return -EBUSY;
+
+	ret = regmap_update_bits(pma, reg, l2d,
+				 AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_LCK2DATA);
+	if (ret)
+		goto restore;
+	ret = regmap_update_bits(pma, reg, rst,
+				 AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_RSTB);
+	if (ret)
+		goto restore;
+	usleep_range(700, 1000);
+	ret = regmap_set_bits(pma, reg, AIROHA_PCS_PMA_FORCE_DA_CDR_LPF_RSTB);
+	if (ret)
+		goto restore;
+	usleep_range(100, 200);
+	ret = regmap_set_bits(pma, reg, AIROHA_PCS_PMA_FORCE_DA_CDR_LPF_LCK2DATA);
+	if (ret)
+		goto restore;
+	ret = regmap_clear_bits(pma, reg, AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_RSTB);
+	if (ret)
+		goto restore;
+	ret = regmap_clear_bits(pma, reg, AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_LCK2DATA);
+	if (!ret)
+		return 0;
+
+restore:
+	/* Preserve the original error even if best-effort cleanup also fails. */
+	regmap_update_bits(pma, reg, l2d | rst, saved);
+	return ret;
+}
+
+static unsigned int airoha_pcs_recovery_backoff(struct airoha_pcs_port *port)
+{
+	struct airoha_pcs_recovery *r = &port->recovery;
+	unsigned int delay;
+
+	if (r->attempts >= AIROHA_PCS_RECOVERY_TRIES) {
+		delay = AIROHA_PCS_COOLDOWN_MS;
+		r->attempts = 0;
+	} else {
+		delay = AIROHA_PCS_HEALTH_MS << (r->attempts - 1);
+	}
+	r->retry_at = jiffies + msecs_to_jiffies(delay);
+	r->waiting = true;
+	return AIROHA_PCS_HEALTH_MS;
+}
+
+/* Returns the next check interval, or zero when this port must not be polled. */
+static unsigned int airoha_pcs_recovery_step(struct airoha_pcs_port *port)
+{
+	struct airoha_pcs_priv *priv = port->priv;
+	struct airoha_pcs_maps *maps = &priv->maps[port->index];
+	struct airoha_pcs_recovery *r = &port->recovery;
+	bool signal;
+	u32 sync = 0, freq = 0, status = 0;
+	int ret;
+
+	if (!r->enabled || !r->configured || !r->link_requested ||
+	    port->config_error)
+		return 0;
+
+	ret = regmap_read(maps->hsgmii_pcs, ARIOHA_PCS_HSGMII_PCS_STATE_2, &sync);
+	if (ret)
+		goto error;
+	ret = regmap_read(priv->pcs_pma[port->index], AIROHA_PCS_PMA_RX_FREQDET, &freq);
+	if (ret)
+		goto error;
+	ret = regmap_read(maps->multi_sgmii, AIROHA_PCS_MULTI_SGMII_MSG_RX_STS_15,
+			  &status);
+	if (ret)
+		goto error;
+
+	if ((sync & AIROHA_PCS_HSGMII_PCS_RX_SYNC) &&
+	    (freq & AIROHA_PCS_PMA_FBCK_LOCK)) {
+		r->last_error = 0;
+		if (r->suspect && r->verifying)
+			dev_info(priv->dev, "PCS %d HSGMII CDR recovered\n", port->index);
+		r->suspect = false;
+		r->verifying = false;
+		r->attempts = 0;
+		r->retry_at = 0;
+		r->waiting = false;
+		return AIROHA_PCS_HEALTH_MS;
+	}
+
+	if (!r->suspect) {
+		r->suspect = true;
+		return AIROHA_PCS_CONFIRM_MS;
+	}
+	if (r->verifying) {
+		r->verifying = false;
+		return airoha_pcs_recovery_backoff(port);
+	}
+	if (r->waiting && time_before(jiffies, r->retry_at))
+		return AIROHA_PCS_HEALTH_MS;
+	r->waiting = false;
+
+	/* Internal port status is diagnostic, not sufficient to justify a reset. */
+	if (sync & AIROHA_PCS_HSGMII_PCS_RX_SYNC)
+		return AIROHA_PCS_HEALTH_MS;
+	ret = airoha_pcs_hsgmii_signal(port, &signal);
+	if (ret)
+		goto error;
+	r->last_error = 0;
+	if (!signal)
+		return AIROHA_PCS_HEALTH_MS;
+
+	r->attempts++;
+	ret = airoha_pcs_hsgmii_relock(port);
+	dev_warn_ratelimited(priv->dev,
+			     "PCS %d HSGMII CDR attempt %u: sync=%#x freq=%#x port=%#x error=%d\n",
+			     port->index, r->attempts, sync, freq, status, ret);
+	if (ret)
+		return airoha_pcs_recovery_backoff(port);
+	r->verifying = true;
+	return AIROHA_PCS_CONFIRM_MS;
+
+error:
+	if (r->last_error != ret)
+		dev_warn_ratelimited(priv->dev, "PCS %d HSGMII health read failed: %d\n",
+				     port->index, ret);
+	r->last_error = ret;
+	return AIROHA_PCS_HEALTH_MS;
+}
+
+static void airoha_pcs_recovery_work(struct work_struct *work)
+{
+	struct airoha_pcs_port *port = container_of(to_delayed_work(work),
+						 struct airoha_pcs_port, health_work);
+	unsigned int delay;
+
+	guard(mutex)(&port->lock);
+	delay = airoha_pcs_recovery_step(port);
+	if (delay)
+		queue_delayed_work(system_power_efficient_wq, &port->health_work,
+				   msecs_to_jiffies(delay));
+}
+
+void airoha_pcs_recovery_stop(struct airoha_pcs_port *port, bool disable)
+{
+	/* The worker never takes RTNL, PHY or phylink locks. */
+	mutex_lock(&port->lock);
+	port->recovery.configured = false;
+	port->recovery.link_requested = false;
+	if (disable)
+		port->recovery.enabled = false;
+	mutex_unlock(&port->lock);
+	/* Never wait for a worker while holding its mutex. */
+	cancel_delayed_work_sync(&port->health_work);
+}
+
+/* Called with port->lock held, only after a successful link-up. */
+void airoha_pcs_recovery_arm(struct airoha_pcs_port *port)
+{
+	struct airoha_pcs_recovery *r = &port->recovery;
+
+	if (!r->enabled || !r->configured || port->config_error)
+		return;
+	r->link_requested = true;
+	r->suspect = false;
+	r->verifying = false;
+	r->attempts = 0;
+	r->retry_at = 0;
+	r->waiting = false;
+	r->last_error = 0;
+	mod_delayed_work(system_power_efficient_wq, &port->health_work,
+			 msecs_to_jiffies(AIROHA_PCS_CONFIRM_MS));
+}
+
+static void airoha_pcs_recovery_release(void *data)
+{
+	airoha_pcs_recovery_stop(data, true);
+}
+
+int airoha_pcs_recovery_init(struct airoha_pcs_port *port)
+{
+	mutex_init(&port->lock);
+	INIT_DELAYED_WORK(&port->health_work, airoha_pcs_recovery_work);
+	return devm_add_action_or_reset(port->priv->dev,
+					airoha_pcs_recovery_release, port);
+}
