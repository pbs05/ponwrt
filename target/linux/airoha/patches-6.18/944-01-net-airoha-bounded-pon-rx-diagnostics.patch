index a8b7b0b..bf46e08 100644
--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -10,2 +10,2 @@ obj-$(CONFIG_NET_AIROHA_PRIORITY_KUNIT_TEST) += airoha_priority_test.o
-airoha-eth-$(CONFIG_DEBUG_FS) += airoha_ppe_debugfs.o
+airoha-eth-$(CONFIG_DEBUG_FS) += airoha_ppe_debugfs.o airoha_pon_rx_diag.o
 obj-$(CONFIG_NET_AIROHA_NPU) += airoha_npu.o
diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
index 37f53f9..03dc634 100644
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -1017,4 +1017,9 @@ static int airoha_qdma_rx_process(struct airoha_queue *q, int budget)
 			WRITE_ONCE(dev->pon_stats.last_rx_msg0, msg0);
 			WRITE_ONCE(dev->pon_stats.last_rx_msg1, msg1);
+			if (IS_ENABLED(CONFIG_DEBUG_FS) &&
+			    unlikely(smp_load_acquire(&eth->pon_rx_diag_active)) &&
+			    (pon_control || !q->skb))
+				airoha_pon_rx_diag_record(q, dev, desc, e->buf,
+							  len, pon_control);
 			if (msg0 & QDMA_ETH_RXMSG_CRC_ERR_MASK)
 				atomic64_inc(&dev->pon_stats.rx_crc_errors);
@@ -5192,4 +5197,5 @@ static void airoha_napi_map_init(struct airoha_eth *eth)
 	debugfs_create_file("napi_map", 0400, eth->napi_debugfs, eth,
 			    &airoha_napi_map_fops);
+	airoha_pon_rx_diag_init(eth);
 }
 
diff --git a/drivers/net/ethernet/airoha/airoha_eth.h b/drivers/net/ethernet/airoha/airoha_eth.h
